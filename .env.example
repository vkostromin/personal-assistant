# GCP
PROJECT_ID=your-gcp-project-id
REGION=us-central1
# OAuth client of type "Web application" with authorized redirect URI <PUBLIC_URL>/oauth/callback
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# Public Cloud Run URL (no trailing slash). Used for the Google sign-in redirect.
PUBLIC_URL=https://your-service.a.run.app

# Shared LLM — the first provider in LLM_PROVIDER_ORDER with a key set is used
# LLM_PROVIDER_ORDER=gemini,deepseek,openai
# Gemini API key from https://aistudio.google.com/apikey (use a project with billing enabled)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://opencode.ai/zen/go/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Per-user limit for the shared key (tokens per 12h; ~100 emails). Own keys & admins: unlimited.
USER_TOKEN_LIMIT=150000

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Bot username without "@" (optional — looked up automatically), used in invitation links
TELEGRAM_BOT_USERNAME=
# REQUIRED for multi-user: without it anyone can forge updates as any user
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret

# Secret header Cloud Scheduler sends to /run
RUN_SECRET=generate-another-random-secret

# Token encryption — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Optional: only this Telegram user id may become the first admin.
# Leave empty and the first person to send /start to the bot becomes admin.
ADMIN_TELEGRAM_ID=

# Timezone for users who haven't set one with /timezone (IANA name), and local summary hours
DEFAULT_TIMEZONE=UTC
# SUMMARY_HOURS=8,20
# No reminders during these local hours
# QUIET_HOURS=21-8
# "Waiting for" items without a deadline become due after
# WAITING_DEFAULT_HOURS=48
# MAX_REMINDERS_PER_RUN=5
# /review: items older than this many days
# REVIEW_AFTER_DAYS=7

# Mail volume: per run (since the previous one) / first run of a new account (own AI key: no count limit)
# MAX_MESSAGES_PER_RUN=100
# INITIAL_LOOKBACK_HOURS=168
# MAX_MESSAGES_FIRST_RUN=200
# EMAIL_BATCH_SIZE=20

# Optional overrides
SIGNATURE=Lola, Your AI Assistant
# INVITE_TTL_HOURS=72
# OAUTH_LINK_TTL_MINUTES=15
# INITIAL_LOOKBACK_HOURS=12
# RUN_CONCURRENCY=5
# RUN_SOFT_DEADLINE_SECONDS=240
