# GCP
PROJECT_ID=your-gcp-project-id
REGION=us-central1
# OAuth client of type "Web application" with authorized redirect URI <PUBLIC_URL>/oauth/callback
GOOGLE_CLIENT_ID=your-oauth-client-id
GOOGLE_CLIENT_SECRET=your-oauth-client-secret

# Public Cloud Run URL (no trailing slash). Used for the Google sign-in redirect.
PUBLIC_URL=https://your-service.a.run.app

# Shared AI — the FIRST provider with a key is used: Gemini -> DeepSeek -> OpenAI.
# Gemini key: aistudio.google.com/apikey (enable billing on its project: on the free
# tier Google may use prompts — i.e. your users' emails — to improve its products).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_API_KEY=
# DEEPSEEK_API_URL=https://opencode.ai/zen/go/v1/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Per-user limits on the shared key (users with their own key via /setkey have none).
# A window = 12h, reset by each scheduled run. When the tokens are used up, draft
# replies, /rewrite, /chat and /raw pause until the next run; summaries continue.
USER_TOKEN_LIMIT=150000
USER_EMAIL_LIMIT=100
# LIMIT_ADMINS=false

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Bot username without "@" (optional — looked up automatically), used in invitation links
TELEGRAM_BOT_USERNAME=
# REQUIRED for multi-user: without it anyone can forge updates as any user
TELEGRAM_WEBHOOK_SECRET=generate-a-random-secret

# Secret header Cloud Scheduler sends to /run
RUN_SECRET=generate-another-random-secret

# Token encryption — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Optional: only this Telegram user id may become the first admin.
# Leave empty and the first person to send /start to the bot becomes admin.
ADMIN_TELEGRAM_ID=

# Optional overrides
SIGNATURE=Lola, Your AI Assistant
# INVITE_TTL_HOURS=72
# OAUTH_LINK_TTL_MINUTES=15
# INITIAL_LOOKBACK_HOURS=12
# RUN_CONCURRENCY=3
# MAX_EMAILS_PER_RUN=200         # hard cap, also for own-key users/admins (300s request timeout)
# RUN_TIME_BUDGET_SECONDS=240
