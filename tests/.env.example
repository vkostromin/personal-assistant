# Settings used by the test suite (copy to tests/.env to override locally; tests/.env is git-ignored).
# These are dummy values — tests never call Google, Telegram or an LLM.
PROJECT_ID=test-project
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret
TOKEN_ENCRYPTION_KEY=test-encryption-key-1234567890123456
TELEGRAM_WEBHOOK_SECRET=test-webhook-secret
RUN_SECRET=test-run-secret
TELEGRAM_BOT_TOKEN=test-bot-token
TELEGRAM_BOT_USERNAME=lola_test_bot
PUBLIC_URL=https://lola.example.run.app
ADMIN_TELEGRAM_ID=
GEMINI_API_KEY=server-gemini-key
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
USER_TOKEN_LIMIT=150000
